# ------------------------------------------------------------------
# ตัวอย่างไฟล์ environment — คัดลอกเป็น .env แล้วใส่ค่าจริง
#   cp .env.example .env   (หรือ Copy-Item .env.example .env)
# ไฟล์ .env ตัวจริงจะถูก .gitignore ไม่ให้ขึ้น git
# ------------------------------------------------------------------

# Base URL ของ backend API
API_BASE_URL=https://api.example.com

# API key / token (ห้าม commit ค่าจริง)
API_KEY=your_api_key_here

# สภาพแวดล้อม: dev | staging | production
APP_ENV=dev
